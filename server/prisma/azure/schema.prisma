generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  AGENT
}

enum Channel {
  WHATSAPP
  SITE
  APP
}

enum TicketStatus {
  NEW
  AI_TRIAGE
  OPEN
  PENDING
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SenderType {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTickets Ticket[]  @relation("AssignedTickets")
  messages        Message[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  claroId   String?
  cpfCnpj   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model Ticket {
  id            String       @id @default(cuid())
  protocol      String       @unique
  channel       Channel
  subject       String
  summary       String?
  status        TicketStatus @default(NEW)
  priority      Priority     @default(MEDIUM)
  aiConfidence  Float?
  tags          String?
  externalRef   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lastMessageAt DateTime     @default(now())

  customer     Customer       @relation(fields: [customerId], references: [id])
  customerId   String
  assignedTo   User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  assignedToId String?
  messages     Message[]
  suggestions  AiSuggestion[]

  @@index([status, channel])
  @@index([lastMessageAt])
}

model Message {
  id           String     @id @default(cuid())
  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  senderType   SenderType
  body         String
  metadata     String?
  authorUser   User?      @relation(fields: [authorUserId], references: [id])
  authorUserId String?
  createdAt    DateTime   @default(now())

  @@index([ticketId, createdAt])
}

model AiSuggestion {
  id             String   @id @default(cuid())
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId       String
  intent         String
  sentiment      String
  confidence     Float
  suggestedReply String
  nextBestAction String
  createdAt      DateTime @default(now())
}

model IntegrationEvent {
  id          String   @id @default(cuid())
  source      String
  eventType   String
  externalId  String?
  payload     String
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([source, eventType])
}
